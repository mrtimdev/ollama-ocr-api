OLLAMA_API_KEY=your-ollama-cloud-key

# Client keys can use either name:key pairs...
API_KEYS=warehouse:replace-with-a-long-random-key,backoffice:replace-with-another-key
# ...or JSON: {"warehouse":"key-one","backoffice":"key-two"}

# Protects the monitoring Socket.IO connection and monitoring REST endpoint.
# Leave unset only when the dashboard is on a trusted private network.
MONITOR_API_KEY=replace-with-a-monitor-key

OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_HOST=https://ollama.com
PORT=3000
MAX_BATCH_SIZE=5
QUEUE_CONCURRENCY=2
JOB_RETENTION_MS=3600000

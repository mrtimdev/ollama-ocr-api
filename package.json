{
  "name": "khb-invoice-ocr-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Node.js API for KHB invoice OCR using Ollama Cloud",
  "main": "batch.js",
  "scripts": {
    "start": "node --env-file=.env batch.js",
    "dev": "node --env-file=.env --watch batch.js",
    "single": "node --env-file=.env app.js",
    "batch": "node --env-file=.env --watch batch.js",
    "css:build": "npx @tailwindcss/cli -i ./public/assets/input.css -o ./public/assets/styles.css --minify",
    "css:watch": "npx @tailwindcss/cli -i ./public/assets/input.css -o ./public/assets/styles.css --watch",
    "test": "node --test",
    "deploy": "vercel",
    "deploy:prod": "vercel --prod"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
